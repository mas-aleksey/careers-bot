# Токен бота от @BotFather. Файл .env держать в режиме 600, в git не класть.
TG_BOT_TOKEN=123456:AA...

# Хост в формате OpenAI, без /v1. Без строки — OpenRouter. Свой пул подписок Claude:
# OPENROUTER_HOST=http://claude-pool:8080, ключ пула — в OPENROUTER_API_KEY,
# модели только anthropic/claude-*.
# OPENROUTER_HOST=
# Ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Модель для сборки профиля и оценки вакансий.
# На типичной нагрузке (50 новых вакансий в день, несколько профилей в месяц):
#   anthropic/claude-sonnet-5   ~$3/мес   — качество, берём по умолчанию
#   anthropic/claude-haiku-4.5  ~$1.4/мес
#   google/gemini-2.5-flash     ~$0.6/мес
#   openai/gpt-5-mini           ~$0.5/мес
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Дешёвая модель читает каждую новую вакансию один раз и заполняет паспорт:
# страны найма, формат, грейд, стек, домен. На нём работают ворота и теги,
# поэтому до дорогой модели доходит малая часть вакансий.
OPENROUTER_TRIAGE_MODEL=google/gemini-2.5-flash-lite
